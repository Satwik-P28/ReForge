    { "action": "complete", "kind": "click", "role": "button", "name": "Done" },
    { "action": "delete", "kind": "click", "role": "button", "name": "Delete" },
    { "action": "show-open", "kind": "click", "role": "button", "name": "Show open" },
    { "action": "show-all", "kind": "click", "role": "button", "name": "Show all" },
    { "action": "clear-done", "kind": "click", "role": "button", "name": "Clear done" }
  ]
}
