{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Satwik-P28/ReForge/schemas/capability-package.schema.json",
  "title": "ReForge Capability Package Manifest",
  "description": "JSON Schema (draft-07) for CapabilityPackage manifest format version 1.0.0.",
  "type": "object",
  "required": [
    "schema_version",
    "package_format_version",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Document schema version."
    },
    "package_format_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "On-disk package format version."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable capability identity."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Capability semantic version (semver).",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "interfaces": { "$ref": "#/definitions/PackageInterfaces" },
    "data_models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/TypeDesc" }
    },
    "state_schema": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/TypeDesc" }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contract_inline": {
      "type": "array",
      "items": { "$ref": "#/definitions/CapabilityContract" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/DependencyDecl" }
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/definitions/PermissionReq" }
    },
    "runtime_requirements": {
      "type": "array",
      "items": { "$ref": "#/definitions/RuntimeRequirement" }
    },
    "implementations": {
      "type": "array",
      "items": { "$ref": "#/definitions/ImplementationRef" }
    },
    "test_fixtures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "twin_ref": { "type": "string" },
    "ui_bindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/UiBinding" }
    },
    "persistence_bindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/PersistenceBinding" }
    },
    "implementation_status": {
      "type": "string",
      "enum": ["spec_only", "partial", "reference_available"],
      "default": "spec_only"
    },
    "certainty": { "$ref": "#/definitions/Certainty" }
  },
  "definitions": {
    "Certainty": {
      "type": "string",
      "enum": [
        "observed",
        "specified",
        "inferred",
        "hypothetical",
        "unknown",
        "contradictory",
        "verified_under_test"
      ]
    },
    "TypeDesc": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["null", "bool", "int", "float", "string", "bytes"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "item"],
          "properties": {
            "kind": { "const": "list" },
            "item": { "$ref": "#/definitions/TypeDesc" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "map" },
            "value": { "$ref": "#/definitions/TypeDesc" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "properties": {
            "kind": { "const": "object" },
            "fields": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/FieldDesc" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "variants"],
          "properties": {
            "kind": { "const": "enum" },
            "variants": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "inner"],
          "properties": {
            "kind": { "const": "optional" },
            "inner": { "$ref": "#/definitions/TypeDesc" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "variants"],
          "properties": {
            "kind": { "const": "union" },
            "variants": {
              "type": "array",
              "items": { "$ref": "#/definitions/TypeDesc" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ref" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "FieldDesc": {
      "type": "object",
      "required": ["ty"],
      "properties": {
        "ty": { "$ref": "#/definitions/TypeDesc" },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "OperationSig": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/TypeDesc" }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/TypeDesc" }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "EventSig": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/TypeDesc" }
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ErrorSig": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "PackageInterfaces": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/OperationSig" }
        },
        "queries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/OperationSig" }
        },
        "events": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/EventSig" }
        },
        "errors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/ErrorSig" }
        }
      },
      "additionalProperties": false
    },
    "DependencyDecl": {
      "type": "object",
      "required": ["capability_id", "version_req"],
      "properties": {
        "capability_id": { "type": "string" },
        "version_req": { "type": "string" },
        "optional": { "type": "boolean", "default": false },
        "required_interfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "PermissionReq": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RuntimeRequirement": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version_req": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ImplementationKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["reference_twin", "spec_only"]
        },
        {
          "type": "object",
          "required": ["host_builtin"],
          "properties": {
            "host_builtin": {
              "type": "object",
              "required": ["module"],
              "properties": {
                "module": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "string",
          "description": "Extension kind as Other(String) in Rust."
        }
      ]
    },
    "ImplementationRef": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "$ref": "#/definitions/ImplementationKind" },
        "path": {
          "type": "string",
          "description": "Relative path inside the package; never executed during inspect/validate.",
          "not": { "pattern": "(^|[\\\\/])\\.\\.($|[\\\\/])|^[\\\\/]" }
        },
        "version": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "environment": {
          "type": "array",
          "items": { "type": "string" }
        },
        "demonstrated_by_tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "UiBinding": {
      "type": "object",
      "required": ["surface"],
      "properties": {
        "surface": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "PersistenceBinding": {
      "type": "object",
      "required": ["store"],
      "properties": {
        "store": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SideEffect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "store"],
          "properties": {
            "kind": { "const": "persist" },
            "store": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "event"],
          "properties": {
            "kind": { "const": "emit_event" },
            "event": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "level"],
          "properties": {
            "kind": { "const": "log" },
            "level": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "description"],
          "properties": {
            "kind": { "const": "external" },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ContractClause": {
      "type": "object",
      "required": ["id", "expression"],
      "properties": {
        "id": { "type": "string" },
        "expression": {
          "description": "Expression AST object or string DSL.",
          "oneOf": [{ "type": "object" }, { "type": "string" }]
        },
        "applies_to": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CapabilityContract": {
      "type": "object",
      "required": ["schema_version", "id", "name"],
      "properties": {
        "schema_version": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContractClause" }
        },
        "postconditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContractClause" }
        },
        "invariants": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContractClause" }
        },
        "transition_constraints": { "type": "array" },
        "error_conditions": { "type": "array" },
        "permitted_side_effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/SideEffect" }
        },
        "event_production": { "type": "array" },
        "persistence_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interface_requirements": { "type": "array" },
        "environmental_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  }
}
