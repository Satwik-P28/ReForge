{
  "schema_version": "1.0.0",
  "id": "notes-twin",
  "name": "Notes Behavioral Twin",
  "description": "Multi-note map CRUD encoded entirely in portable twin+expr (map_put/get/remove/keys/list_append). No host builtin required. search_notes is limited (returns all keys).",
  "initial_state": "ready",
  "states": {
    "ready": {
      "name": "ready",
      "terminal": false
    }
  },
  "variables": {
    "notes": {
      "name": "notes",
      "ty": {
        "kind": "map",
        "value": {
          "kind": "map",
          "value": {
            "kind": "string"
          }
        }
      },
      "initial": {
        "kind": "map",
        "value": {}
      },
      "required": true
    },
    "op_count": {
      "name": "op_count",
      "ty": {
        "kind": "int"
      },
      "initial": {
        "kind": "int",
        "value": 0
      },
      "required": true
    }
  },
  "actions": {
    "create_note": {
      "name": "create_note",
      "parameters": {
        "id": {
          "kind": "string"
        },
        "title": {
          "kind": "string"
        },
        "body": {
          "kind": "string"
        }
      },
      "description": "Create a note with unique id and empty tags"
    },
    "update_note": {
      "name": "update_note",
      "parameters": {
        "id": {
          "kind": "string"
        },
        "title": {
          "kind": "string"
        },
        "body": {
          "kind": "string"
        }
      },
      "description": "Update title and body of an existing note (both required)"
    },
    "delete_note": {
      "name": "delete_note",
      "parameters": {
        "id": {
          "kind": "string"
        }
      },
      "description": "Delete a note by id"
    },
    "read_note": {
      "name": "read_note",
      "parameters": {
        "id": {
          "kind": "string"
        }
      },
      "description": "Read a note map by id"
    },
    "list_notes": {
      "name": "list_notes",
      "parameters": {},
      "description": "List all note ids"
    },
    "search_notes": {
      "name": "search_notes",
      "parameters": {
        "query": {
          "kind": "string"
        }
      },
      "description": "Limited Phase 1 search: returns all note keys (query ignored)"
    },
    "tag_note": {
      "name": "tag_note",
      "parameters": {
        "id": {
          "kind": "string"
        },
        "tag": {
          "kind": "string"
        }
      },
      "description": "Append a tag string to a note's tags list"
    }
  },
