      "action": "create_note",
      "guard": {
        "op": "not",
        "arg": {
          "op": "contains",
          "collection": {
            "op": "ref",
            "root": "state",
            "path": [
              "notes"
            ]
          },
          "item": {
            "op": "ref",
            "root": "input",
            "path": [
              "id"
            ]
          }
        }
      },
      "updates": {
        "notes": {
          "op": "map_put",
          "map": {
            "op": "ref",
            "root": "state",
            "path": [
              "notes"
            ]
          },
          "key": {
            "op": "ref",
            "root": "input",
            "path": [
              "id"
            ]
          },
          "value": {
            "op": "map_lit",
            "entries": [
              [
                "id",
                {
                  "op": "ref",
                  "root": "input",
                  "path": [
                    "id"
                  ]
                }
              ],
              [
