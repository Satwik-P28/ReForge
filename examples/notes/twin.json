                {
                  "op": "list_lit",
                  "items": []
                }
              ]
            ]
          }
        },
        "op_count": {
          "op": "add",
          "left": {
            "op": "ref",
            "root": "state",
            "path": [
              "op_count"
            ]
          },
          "right": {
            "op": "lit_int",
            "value": 1
          }
        }
      },
      "outputs": {
        "id": {
          "op": "ref",
          "root": "input",
          "path": [
            "id"
          ]
        }
      },
      "events": [
        "note_created"
      ],
      "certainty": "specified",
      "evidence_refs": [
        "ev-notes-spec"
