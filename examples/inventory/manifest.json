{
  "schema_version": "1.0.0",
  "package_format_version": "1.0.0",
  "id": "reforge.examples.inventory",
  "name": "Inventory",
  "description": "Multi-SKU inventory with reservation semantics. Executable behavior is fully encoded in the portable Behavioral Twin (no host builtin).",
  "version": "0.1.0",
  "author": "ReForge Contributors",
  "license": "Apache-2.0",
  "interfaces": {
    "commands": {
      "add_item": {
        "inputs": {
          "sku": {
            "kind": "string"
          },
          "name": {
            "kind": "string"
          },
          "qty": {
            "kind": "int"
          }
        },
        "outputs": {
          "sku": {
            "kind": "string"
          }
        },
        "errors": [
          "duplicate_sku"
        ]
      },
      "adjust_stock": {
        "inputs": {
          "sku": {
            "kind": "string"
          },
          "delta": {
            "kind": "int"
          }
        },
        "outputs": {
          "sku": {
            "kind": "string"
          }
        },
        "errors": [
          "not_found",
          "insufficient_stock"
        ]
      },
      "reserve": {
        "inputs": {
          "sku": {
            "kind": "string"
          },
          "qty": {
            "kind": "int"
          }
        },
        "outputs": {
          "sku": {
            "kind": "string"
          },
          "reserved_added": {
            "kind": "int"
          }
        },
        "errors": [
          "insufficient_stock",
          "not_found"
        ]
      },
      "release": {
        "inputs": {
          "sku": {
            "kind": "string"
          },
          "qty": {
            "kind": "int"
          }
        },
        "outputs": {
          "sku": {
            "kind": "string"
          }
        },
        "errors": [
          "not_found"
        ]
      },
      "fulfill": {
        "inputs": {
          "sku": {
            "kind": "string"
          },
          "qty": {
            "kind": "int"
          }
        },
        "outputs": {
          "sku": {
            "kind": "string"
          }
        },
        "errors": [
          "not_found"
        ]
      },
      "remove_item": {
        "inputs": {
          "sku": {
            "kind": "string"
          }
        },
        "outputs": {
          "sku": {
            "kind": "string"
          }
        },
        "errors": [
          "not_found",
          "has_reservations"
        ]
      }
    },
    "queries": {
      "query_item": {
        "inputs": {
          "sku": {
            "kind": "string"
          }
        },
        "outputs": {
          "item": {
            "kind": "map",
            "value": {
              "kind": "int"
            }
          }
        },
        "errors": [
          "not_found"
        ]
      },
      "list_items": {
        "inputs": {},
        "outputs": {
          "skus": {
            "kind": "list",
            "item": {
              "kind": "string"
            }
          }
        },
        "errors": []
      }
    },
    "events": {
      "item_added": {
        "payload": {
          "sku": {
            "kind": "string"
          }
        }
      },
      "reserved": {
        "payload": {
          "sku": {
            "kind": "string"
          }
        }
      },
      "fulfilled": {
        "payload": {
          "sku": {
            "kind": "string"
          }
        }
      },
      "item_removed": {
        "payload": {
          "sku": {
            "kind": "string"
          }
        }
      }
    },
    "errors": {
      "duplicate_sku": {
        "code": "duplicate_sku"
      },
      "not_found": {
        "code": "not_found"
      },
      "insufficient_stock": {
        "code": "insufficient_stock"
      },
      "has_reservations": {
        "code": "has_reservations"
      }
    }
  },
  "data_models": {
    "Item": {
      "kind": "object",
      "fields": {
        "name": {
          "ty": {
            "kind": "string"
          },
          "required": true
        },
        "qty": {
          "ty": {
            "kind": "int"
          },
          "required": true
        },
        "reserved": {
          "ty": {
            "kind": "int"
          },
          "required": true
        }
      }
    }
  },
  "state_schema": {
    "items": {
      "kind": "map",
      "value": {
        "kind": "ref",
        "name": "Item"
      }
    },
    "op_count": {
      "kind": "int"
    }
  },
  "contracts": [
    "inventory-contract"
  ],
  "contract_inline": [
    {
      "schema_version": "1.0.0",
      "id": "inventory-contract",
      "name": "Inventory reservation contract",
      "description": "Independent specified rules: reserved never exceeds qty; op_count non-negative; items defined.",
      "preconditions": [],
      "postconditions": [],
      "invariants": [
        {
          "id": "items-defined",
          "expression": "is_defined(state.items)",
          "description": "items map defined"
        },
        {
          "id": "op-nonneg",
          "expression": "state.op_count >= 0",
          "description": "op_count >= 0"
        }
      ],
      "transition_constraints": [],
      "error_conditions": [
        {
          "id": "dup",
          "error": "duplicate_sku",
          "when": "add_item with existing sku"
        },
        {
          "id": "insuff",
          "error": "insufficient_stock",
          "when": "reserve beyond available"
        }
      ],
      "permitted_side_effects": [
        {
          "kind": "persist",
          "store": "memory"
        }
      ],
      "event_production": [
        {
          "name": "reserved",
          "payload": {
            "sku": {
              "kind": "string"
            }
          }
        }
      ],
      "persistence_assumptions": [
        "In-memory twin state only"
      ],
      "interface_requirements": [],
      "environmental_assumptions": [
        "Deterministic twin interpreter; no host builtin required"
      ]
    }
  ],
  "dependencies": [],
  "permissions": [],
  "runtime_requirements": [
    {
      "name": "reforge-behavior",
      "version_req": ">=0.1.0",
      "notes": "Requires map_put/map_get/map_remove/keys expr ops"
    }
  ],
  "implementations": [
    {
      "id": "inventory-twin",
      "kind": "reference_twin",
      "path": "twin.json",
      "version": "0.1.0",
      "operations": [
        "add_item",
        "adjust_stock",
        "reserve",
        "release",
        "fulfill",
        "query_item",
        "list_items",
        "remove_item"
      ],
      "environment": [
        "reforge-twin-engine"
      ],
      "demonstrated_by_tests": [
        "crates/reforge/tests/e2e_inventory.rs"
      ],
      "notes": "No host builtin. Portable twin is the sole executable reference."
    }
  ],
  "test_fixtures": [
    "fixtures/traces/inventory-trace.json"
  ],
  "evidence": [
    "ev-inventory-spec"
  ],
  "twin_ref": "inventory-twin",
  "ui_bindings": [
    {
      "surface": "unspecified",
      "notes": "UI unbound in Phase 1"
    }
  ],
  "persistence_bindings": [
    {
      "store": "memory"
    }
  ],
  "implementation_status": "reference_available",
  "certainty": "specified"
}
