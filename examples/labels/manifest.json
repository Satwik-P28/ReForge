{
  "schema_version": "1.0.0",
  "package_format_version": "1.0.0",
  "id": "reforge.examples.labels",
  "name": "Labels",
  "description": "Fourth capability authored solely through public package interfaces. Manages named labels for tagging entities.",
  "version": "0.1.0",
  "author": "ReForge Contributors",
  "license": "Apache-2.0",
  "interfaces": {
    "commands": {
      "create_label": {
        "inputs": {
          "id": {
            "kind": "string"
          },
          "name": {
            "kind": "string"
          },
          "color": {
            "kind": "string"
          }
        },
        "outputs": {
          "id": {
            "kind": "string"
          }
        },
        "errors": [
          "duplicate_id"
        ],
        "description": "Create a label"
      },
      "delete_label": {
        "inputs": {
          "id": {
            "kind": "string"
          }
        },
        "outputs": {
          "deleted": {
            "kind": "string"
          }
        },
        "errors": [
          "not_found"
        ],
        "description": "Delete a label"
      },
      "rename_label": {
        "inputs": {
          "id": {
            "kind": "string"
          },
          "name": {
            "kind": "string"
          }
        },
        "outputs": {
          "id": {
            "kind": "string"
          }
        },
        "errors": [
          "not_found"
        ],
        "description": "Rename a label"
      }
    },
    "queries": {
      "get_label": {
        "inputs": {
          "id": {
            "kind": "string"
          }
        },
        "outputs": {
          "label": {
            "kind": "map",
            "value": {
              "kind": "string"
            }
          }
        },
        "errors": [
          "not_found"
        ]
      },
      "list_labels": {
        "inputs": {},
        "outputs": {
          "ids": {
            "kind": "list",
            "item": {
              "kind": "string"
            }
          }
        },
        "errors": []
      }
    },
    "events": {
      "label_created": {
        "payload": {
          "id": {
            "kind": "string"
          }
        }
      },
      "label_deleted": {
        "payload": {
          "id": {
            "kind": "string"
          }
        }
      }
    },
    "errors": {
      "duplicate_id": {
        "code": "duplicate_id",
        "description": "Label id exists"
      },
      "not_found": {
        "code": "not_found",
        "description": "Label missing"
      }
    }
  },
  "data_models": {
    "Label": {
      "kind": "object",
      "fields": {
        "id": {
          "ty": {
            "kind": "string"
          },
          "required": true
        },
        "name": {
          "ty": {
            "kind": "string"
          },
          "required": true
        },
        "color": {
          "ty": {
            "kind": "string"
          },
          "required": true
        }
      }
    }
  },
  "state_schema": {
    "labels": {
      "kind": "map",
      "value": {
        "kind": "ref",
        "name": "Label"
      }
    },
    "op_count": {
      "kind": "int"
    }
  },
  "contracts": [
    "labels-contract"
  ],
  "contract_inline": [
    {
      "schema_version": "1.0.0",
      "id": "labels-contract",
      "name": "Labels contract",
      "description": "Label CRUD invariants",
      "preconditions": [],
      "postconditions": [],
      "invariants": [
        {
          "id": "op-nonneg",
          "expression": "state.op_count >= 0",
          "description": "op_count non-negative"
        },
        {
          "id": "labels-defined",
          "expression": "is_defined(state.labels)",
          "description": "labels map defined"
        }
      ],
      "transition_constraints": [],
      "error_conditions": [],
      "permitted_side_effects": [
        {
          "kind": "persist",
          "store": "memory"
        },
        {
          "kind": "emit_event",
          "event": "label_created"
        }
      ],
      "event_production": [
        {
          "name": "label_created",
          "payload": {
            "id": {
              "kind": "string"
            }
          }
        }
      ],
      "persistence_assumptions": [
        "In-memory twin state only"
      ],
      "interface_requirements": [],
      "environmental_assumptions": [
        "Deterministic twin interpreter"
      ]
    }
  ],
  "dependencies": [],
  "permissions": [],
  "runtime_requirements": [
    {
      "name": "reforge-behavior",
      "version_req": ">=0.1.0",
      "notes": "map ops"
    }
  ],
  "implementations": [
    {
      "id": "labels-twin",
      "kind": "reference_twin",
      "path": "twin.json",
      "version": "0.1.0",
      "operations": [
        "create_label",
        "delete_label",
        "rename_label",
        "get_label",
        "list_labels"
      ],
      "environment": [
        "reforge-twin-engine"
      ],
      "demonstrated_by_tests": [
        "crates/reforge/tests/e2e_labels.rs"
      ],
      "notes": "Public-API-only fourth capability"
    }
  ],
  "test_fixtures": [],
  "evidence": [
    "ev-labels-spec"
  ],
  "twin_ref": "labels-twin",
  "ui_bindings": [
    {
      "surface": "unspecified",
      "notes": "UI unbound"
    }
  ],
  "persistence_bindings": [
    {
      "store": "memory",
      "notes": "memory"
    }
  ],
  "implementation_status": "reference_available",
  "certainty": "specified"
}
