{
  "app": "cli-inventory",
  "workflows": [
    {
      "name": "reserve-release-detail",
      "steps": [
        { "action": "add-item", "params": { "name": "widget", "qty": 4 } },
        { "action": "reserve", "params": { "sku": "sku1", "qty": 3 } },
        { "action": "list", "params": {} },
        { "action": "release", "params": { "sku": "sku1", "qty": 1 } },
        { "action": "detail", "params": { "sku": "sku1" } },
        { "action": "stats", "params": {} }
      ]
    },
    {
      "name": "over-ship-and-restock",
      "steps": [
        { "action": "add-item", "params": { "name": "gadget", "qty": 1 } },
        { "action": "reserve", "params": { "sku": "sku1", "qty": 1 } },
        { "action": "ship", "params": { "sku": "sku1", "qty": 1 } },
        { "action": "ship", "params": { "sku": "sku1", "qty": 1 } },
        { "action": "restock", "params": { "sku": "sku1", "qty": 5 } },
        { "action": "stats", "params": {} }
      ]
    }
  ]
}
