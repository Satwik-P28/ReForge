{
  "target_id": "taskbook-0.3.0",
  "target_name": "Taskbook",
  "authorization": "local_fixture",
  "program": "python3",
  "program_args": ["{spec_dir}/adapter.py", "{spec_dir}/runtime/node_modules/taskbook/cli.js"],
  "pristine_dir": "pristine",
  "workdir": "work",
  "state_file": "state.json",
  "timeout_ms": 30000,
  "actions": [
    { "action": "create_task", "argv": ["create_task", "Alpha"], "parameters": { "title": { "kind": "string" } } },
    { "action": "read_task", "argv": ["read_task", "$task_id"], "params": { "task_id": { "kind": "last_entity", "pool": "task" } } },
    { "action": "check_task", "argv": ["check_task", "$task_id"], "params": { "task_id": { "kind": "last_entity", "pool": "task" } } },
    { "action": "delete_task", "argv": ["delete_task", "$task_id"], "params": { "task_id": { "kind": "last_entity", "pool": "task" } } },
    { "action": "stats", "argv": ["stats"] },
    { "action": "missing_task", "argv": ["missing_task", "999"] }
  ]
}
